# ---------------------------------------------------------------------------
# Copiez ce fichier vers .env puis complétez les valeurs.
# .env est ignoré par Git : aucun secret ne doit être commité.
# ---------------------------------------------------------------------------

# --- n8n (hôte local) ------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Paris
N8N_DIAGNOSTICS_ENABLED=false

# Sauvegardez cette clé hors du dépôt : elle chiffre les credentials n8n.
# Laissez vide en local : n8n en génère une au premier démarrage.
N8N_ENCRYPTION_KEY=

# --- Workflows -------------------------------------------------------------
# Module 05 : identifiant du chat Telegram qui reçoit les notifications.
# Récupérez-le via @userinfobot, puis renseignez-le ici.
TELEGRAM_CHAT_ID=

# --- Fournisseurs IA -------------------------------------------------------
# Les workflows utilisent les credentials n8n (Credentials → New).
# Ces variables servent uniquement aux tests en ligne de commande.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
WAVESPEED_API_KEY=
PINECONE_API_KEY=
